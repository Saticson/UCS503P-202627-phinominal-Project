# --- Negations ---
# The repository root .gitignore contains a broad Python-packaging `lib/` rule
# which would otherwise hide real frontend source code under src/lib/.
!frontend/src/lib/
!frontend/src/lib/**

# Java build artifacts
target/
*.class
.mvn/apache-maven-*/

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Docker
.docker/

# Storage data files (keep folders via .gitkeep)
storage/*
!storage/**/.gitkeep
backend-java/storage/*
!backend-java/storage/**/.gitkeep

# Playwright Test Artifacts (Screenshots, Gifs, Videos, Reports)
tests/playwright/test-output/
tests/playwright/playwright-report/
tests/playwright/results/
tests/playwright/test-results/
tests/playwright/blob-report/
tests/playwright/*.png
tests/playwright/*.gif
tests/playwright/*.webm
tests/playwright/*.mp4